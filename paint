import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Graphics;
import java.awt.Graphics2D;
import java.awt.RenderingHints;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.event.MouseMotionAdapter;
import java.awt.image.BufferedImage;
import javax.swing.JButton;
import javax.swing.JComboBox;
import javax.swing.JFrame;
import javax.swing.JPanel;
import javax.swing.SwingUtilities;

public class Dibujo extends JFrame {
    JComboBox<String> comboColores;
    JPanel panelDibujo, panelSuperior;
    JButton btnLimpiar;

    BufferedImage imagen;
    Graphics2D g2;

    int xAnterior, yAnterior;

    public Dibujo() {
        setTitle("Paint con Imagen de Fondo");
        setSize(450, 450);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        comboColores = new JComboBox<>();
        comboColores.addItem("Rojo");
        comboColores.addItem("Verde");
        comboColores.addItem("Azul");

        btnLimpiar = new JButton("Limpiar");

        panelSuperior = new JPanel();
        panelSuperior.add(comboColores);
        panelSuperior.add(btnLimpiar);

        add(panelSuperior, BorderLayout.NORTH);

        imagen = new BufferedImage(300, 300, BufferedImage.TYPE_INT_ARGB);
        g2 = imagen.createGraphics();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // 1. Dibujar imagen de fondo personalizada en lugar del fondo negro
        dibujarFondo();

        // Color inicial por defecto (Rojo)
        g2.setColor(Color.RED);

        panelDibujo = new JPanel() {
            @Override
            protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                g.drawImage(imagen, 40, 10, null);
            }
        };
        panelDibujo.setBackground(Color.YELLOW);

        // Evento Cambio de Color
        comboColores.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                int colorSeleccionado = comboColores.getSelectedIndex();
                switch (colorSeleccionado) {
                    case 0: g2.setColor(Color.RED); break;
                    case 1: g2.setColor(Color.GREEN); break;
                    case 2: g2.setColor(Color.BLUE); break;
                }
            }
        });

        // 2. Funcionalidad del Botón Limpiar
        btnLimpiar.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                Color colorActual = g2.getColor(); // Guardar color de pincel
                dibujarFondo();                    // Reinstaurar imagen de fondo
                g2.setColor(colorActual);          // Restaurar color del pincel
                panelDibujo.repaint();             // Redibujar panel
            }
        });

        // Mouse Presionado
        panelDibujo.addMouseListener(new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                xAnterior = e.getX() - 40;
                yAnterior = e.getY() - 10;
            }
        });

        // Movimiento de Mouse
        panelDibujo.addMouseMotionListener(new MouseMotionAdapter() {
            @Override
            public void mouseDragged(MouseEvent e) {
                int x = e.getX() - 40;
                int y = e.getY() - 10;
                
                g2.drawLine(xAnterior, yAnterior, x, y);

                xAnterior = x;
                yAnterior = y;

                panelDibujo.repaint();
            }
        });

        add(panelDibujo, BorderLayout.CENTER);
    }

    // Método para crear el fondo personalizado (paisaje en lugar del fondo negro)
    private void dibujarFondo() {
        // Cielo
        g2.setColor(new Color(235, 245, 255));
        g2.fillRect(0, 0, imagen.getWidth(), imagen.getHeight());

        // Sol
        g2.setColor(new Color(255, 215, 0));
        g2.fillOval(220, 20, 50, 50);

        // Montañas
        g2.setColor(new Color(180, 200, 220));
        g2.fillPolygon(new int[]{0, 100, 200}, new int[]{250, 120, 250}, 3);
        g2.fillPolygon(new int[]{120, 220, 300}, new int[]{250, 140, 250}, 3);

        // Pasto
        g2.setColor(new Color(144, 238, 144));
        g2.fillRect(0, 240, 300, 60);

        // Retícula suave
        g2.setColor(new Color(220, 220, 220, 120));
        for (int i = 0; i < 300; i += 30) {
            g2.drawLine(i, 0, i, 300);
            g2.drawLine(0, i, 300, i);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            Dibujo d = new Dibujo();
            d.setVisible(true);
        });
    }
}
